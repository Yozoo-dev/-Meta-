# Drawing helpers.
ink <- "#202c3a"; soft <- "#536373"; pale <- "#edf2f6"; teal <- "#087f82"; blue <- "#416fa4"
xcol <- function(id) ifelse(id %in% c("P01","P02","P03"),teal,blue)
study <- function(x) sub("^(WHIS[TH]) \\(.+ ([0-9]{4})\\)$","\\1 \\2",x)
txt <- function(x,y,z,size=9,bold=FALSE,col=ink,align="left") grid.text(z,x,y,just=c(align,"centre"),gp=gpar(fontfamily="sans",fontsize=size,fontface=if(bold) 2 else 1,col=col))
line <- function(x,y,x2,y2,col="#c9d0d8",lwd=.7,lty=1,arrow=NULL) grid.lines(c(x,x2),c(y,y2),gp=gpar(col=col,lwd=lwd,lty=lty),arrow=arrow)
dot <- function(x,y,sz=2,col=teal,pch=16) grid.points(unit(x,"npc"),unit(y,"npc"),pch=pch,size=unit(sz,"mm"),gp=gpar(col=col,fill=col))
note <- function(y,z,fs=8) txt(.025,y,z,fs,col=soft)

# Draw this figure only.
pdf(file.path(out, "Figure_5F_Labbe_broad_infection.pdf"), width = 8.5, height = 4.2,
    useDingbats = FALSE, encoding = "WinAnsi", title = "L'Abbe plots: broad infection")
grid.newpage()
txt(.025, .95, "L'Abbe plots: broad infection", 12, TRUE)

for(q in 1:2){
 id<-c("P03","P05")[q];z<-s[s$pool==id,]; v<-p[p$pool==id,]
 l<-.1+(q-1)*.49; rr<-.44+(q-1)*.49; b<-.22;t<-.80
 xp<-function(x)l+(rr-l)*x/.32;yp<-function(x)b+(t-b)*x/.32
 line(l,b,l,t);line(l,b,rr,b);line(l,b,xp(.32),yp(.32),soft,lty=2)
 line(l,b,xp(.32),yp(.32*v$rr),xcol(id),lty=3)
 for(f in seq(0,.3,.1)){txt(xp(f),b-.045,paste0(f*100,"%"),7.4,align="centre");txt(l-.012,yp(f),paste0(f*100,"%"),7.4,align="right")}
  for(m in seq_len(nrow(z))){
  xx <- xp(z$events_control[m]/z$n_control[m]); yy <- yp(z$events_ciNPWT[m]/z$n_ciNPWT[m])
  dot(xx,yy,sqrt(z$n_ciNPWT[m]+z$n_control[m])*.15,xcol(id),1)
  lbl <- strsplit(study(z$study[m])," ",fixed=TRUE)[[1]][1]
  side <- if(z$events_control[m]/z$n_control[m]>.20) "right" else "left"
  dx <- if(side=="right") -.012 else .012
  dy <- if(lbl=="Stannard") -.018 else if(lbl=="Zhou") .018 else .007
  txt(xx+dx,yy+dy,lbl,6.9,col=soft,align=side)
 }
 txt((l+rr)/2,.85,c("Randomized","Observational")[q],8.5,TRUE,align="centre")
}
