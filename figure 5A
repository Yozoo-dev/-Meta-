# Only base R and grid are needed. This file does not read other scripts or CSVs.

library(grid)
if (.Platform$OS.type == "windows" && !l10n_info()[["UTF-8"]]) {
  invisible(Sys.setlocale("LC_CTYPE", "English_United States.utf8"))
}
argv <- if (sys.nframe() == 0L) commandArgs(trailingOnly = TRUE) else character()
out <- if (length(argv)) argv[1L] else "."
dir.create(out, showWarnings = FALSE, recursive = TRUE)

# Data used by this figure (edit selected values here).
