yy<-seq(.897,.145,length.out=nrow(z)); eps<-diff(rev(yy))[1]
for(m in seq_len(nrow(z))){
 u<-z[m,];y<-yy[m];col<-xcol(u$pool)
 if(is.na(u$rr)){
  rect(.5,y,.95,eps*.92,pale);txt(.03,y,u$label,9,TRUE)
  v<-p[p$pool==u$pool,]; txt(.96,y,paste0("k = ",v$study_count,"; I2 = ",pct(v$i2_fraction)),8,col=soft,align="right")
 } else {
  txt(.045,y,u$label,8.5,u$pooled);txt(.315,y,u$n1,8.5,u$pooled,align="centre")
  txt(.415,y,u$n0,8.5,u$pooled,align="centre");txt(.775,y,ci(u$rr,u$ci_low,u$ci_high),8.5,u$pooled)
  line(x(u$ci_low),y,x(u$ci_high),y,col)
  if(u$pooled) grid.polygon(c(x(u$ci_low),x(u$rr),x(u$ci_high),x(u$rr)),c(y,y+.004,y,y-.004),gp=gpar(fill=col,col=NA))
  else dot(x(u$rr),y,sqrt(u$weight)*.53,col,15)
 }
